# Dave's Domain Monitor - Variables de Entorno de Ejemplo
# Copia este archivo a .env y rellena tus credenciales reales:
# cp .env.example .env

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_CHAT_ID="123456789"

# --- Cloudflare Registrar API (Opcional - Compras 1-Click) ---
CLOUDFLARE_ACCOUNT_ID="tu_account_id_aqui"
CLOUDFLARE_API_TOKEN="tu_api_token_con_permisos_registrar_write"

# --- DonDominio API (Opcional - Verificación de dominios .es) ---
DONDOMINIO_API_USER=""
DONDOMINIO_API_KEY=""

# --- Discord Webhook (Opcional) ---
DISCORD_WEBHOOK_URL=""
